# ==========================================================
# androidimmichml Configuration (.env)
# ==========================================================

# Space-separated list of Android SSH targets (hostnames in ~/.ssh/config or LAN IPs)
NODES="192.168.0.210 192.168.0.211"

# Termux SSH port on the Android devices (Termux default: 8022)
SSH_PORT=8022

# Immich version tag to clone/checkout (must match your main immich-server version)
IMMICH_VERSION="v3.4.1"

# Immich Machine Learning Uvicorn bind settings
ML_HOST="0.0.0.0"
ML_PORT=3003

# Immich ML Worker & Model Cache settings inside Debian proot
MACHINE_LEARNING_CACHE_FOLDER="/root/ml-cache"
MACHINE_LEARNING_WORKERS=1

# Model inactivity timeout in seconds:
#   0   = Keep models in RAM permanently ( prevents single-worker self-shutdown )
#   300 = Unload models after 5m idle ( automatically triggers respawn loop )
MACHINE_LEARNING_MODEL_TTL=0

# Optional CPU threading limits (0 = auto/default)
MACHINE_LEARNING_REQUEST_THREADS=0
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=0
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=0

# Native Termux tmux session name
TMUX_SESSION="immich-ml"
